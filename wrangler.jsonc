{
  "name": "rockfactory",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "rockfactory.uk", "custom_domain": true },
    { "pattern": "www.rockfactory.uk", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "kv_namespaces": [{ "binding": "STATE", "id": "6e1ce10de2d24d22b821064882c0c702" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  // Settings for preview builds of branches and pull requests (wrangler preview).
  // Previews use their own KV namespace so they never touch the live site's state.
  "previews": {
    "kv_namespaces": [{ "binding": "STATE", "id": "c94161e0615b453ea99b40cba3b23d87" }],
    "version_metadata": { "binding": "CF_VERSION_METADATA" }
  }
}
